<Window x:Class="CultureDocs.Views.ReportsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Аналитические отчёты" Height="550" Width="900"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Отчёт по авторам и типам документов"
                   FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

        <DataGrid Grid.Row="1" x:Name="GridReport"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Автор" Binding="{Binding AuthorName}" Width="200"/>
                <DataGridTextColumn Header="Тип документа" Binding="{Binding DocType}" Width="200"/>
                <DataGridTextColumn Header="Документов" Binding="{Binding DocumentCount}" Width="100"/>
                <DataGridTextColumn Header="Версий" Binding="{Binding VersionCount}" Width="100"/>
                <DataGridTextColumn Header="Последняя версия"
                                    Binding="{Binding LastVersionDate, StringFormat=dd.MM.yyyy HH:mm}"
                                    Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Сформировать" Width="120" Height="30" Margin="3"
                    Click="BtnLoad_Click"/>
            <Button Content="Экспорт в CSV" Width="120" Height="30" Margin="3"
                    Click="BtnExport_Click"/>
            <Button Content="Закрыть" Width="100" Height="30" Margin="3"
                    Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>