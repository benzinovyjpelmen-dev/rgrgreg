<Window x:Class="CultureDocs.Views.DocumentEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Документ" Height="560" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="15">
            <TextBlock Text="Название *" Margin="0,5"/>
            <TextBox x:Name="TxtTitle" Height="26" Margin="0,0,0,8"/>

            <TextBlock Text="Тип документа *" Margin="0,5"/>
            <ComboBox x:Name="CmbDocType" Height="26" Margin="0,0,0,8"/>

            <TextBlock Text="Жанр" Margin="0,5"/>
            <TextBox x:Name="TxtGenre" Height="26" Margin="0,0,0,8"/>

            <TextBlock Text="Категория" Margin="0,5"/>
            <ComboBox x:Name="CmbCategory" Height="26" Margin="0,0,0,8"
                      DisplayMemberPath="CategoryName"/>

            <TextBlock Text="Автор *" Margin="0,5"/>
            <ComboBox x:Name="CmbAuthor" Height="26" Margin="0,0,0,8"
                      DisplayMemberPath="FullName"/>

            <TextBlock Text="Мероприятие" Margin="0,5"/>
            <ComboBox x:Name="CmbEvent" Height="26" Margin="0,0,0,8"
                      DisplayMemberPath="EventName"/>

            <TextBlock Text="Статус *" Margin="0,5"/>
            <ComboBox x:Name="CmbStatus" Height="26" Margin="0,0,0,8"/>

            <TextBlock Text="Дата создания" Margin="0,5"/>
            <TextBlock x:Name="TxtCreatedDate" FontStyle="Italic"
                       Foreground="Gray" Margin="0,0,0,8"/>

            <TextBlock Text="Описание" Margin="0,5"/>
            <TextBox x:Name="TxtDescription" Height="70" Margin="0,0,0,8"
                     TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"/>

            <TextBlock Text="Комментарий к версии" Margin="0,5"/>
            <TextBox x:Name="TxtComment" Height="26" Margin="0,0,0,15"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Сохранить" Width="100" Height="30" Margin="3"
                        Click="BtnSave_Click" IsDefault="True"/>
                <Button Content="Отмена" Width="100" Height="30" Margin="3"
                        Click="BtnCancel_Click" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>