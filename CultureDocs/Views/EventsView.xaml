<Window x:Class="CultureDocs.Views.EventsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Справочник мероприятий" Height="500" Width="850"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid Grid.Row="0" x:Name="GridEvents"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding EventID}" Width="50"/>
                <DataGridTextColumn Header="Название" Binding="{Binding EventName}" Width="250"/>
                <DataGridTextColumn Header="Дата"
                                    Binding="{Binding EventDate, StringFormat=dd.MM.yyyy}"
                                    Width="110"/>
                <DataGridTextColumn Header="Место" Binding="{Binding Place}" Width="200"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding EventType}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Добавить" Width="100" Height="30" Margin="3"
                    Click="BtnAdd_Click"/>
            <Button Content="Удалить" Width="100" Height="30" Margin="3"
                    Click="BtnDelete_Click"/>
            <Button Content="Обновить" Width="100" Height="30" Margin="3"
                    Click="BtnRefresh_Click"/>
        </StackPanel>
    </Grid>
</Window>