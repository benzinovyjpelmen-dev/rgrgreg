<Window x:Class="CultureDocs.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Система учёта документации" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Файл">
                <MenuItem Header="Выход" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="Справочники">
                <MenuItem Header="Авторы" Click="MenuAuthors_Click"/>
                <MenuItem Header="Мероприятия" Click="MenuEvents_Click"/>
                <MenuItem Header="Категории" Click="MenuCategories_Click"/>
            </MenuItem>
            <MenuItem Header="Отчёты" Click="MenuReports_Click"/>
            <MenuItem Header="Справка">
                <MenuItem Header="О программе" Click="MenuAbout_Click"/>
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="StatusUser" Text="Пользователь: —"/>
            <Separator/>
            <TextBlock x:Name="StatusRole" Text="Роль: —"/>
        </StatusBar>

        <TabControl Margin="5">
            <TabItem Header="Документы">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Панель фильтров -->
                    <WrapPanel Grid.Row="0" Margin="0,0,0,5">
                        <TextBlock Text="Название:" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtSearchTitle" Width="150" Margin="3"/>
                        <TextBlock Text="Тип:" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <ComboBox x:Name="CmbDocType" Width="130" Margin="3"/>
                        <TextBlock Text="Автор:" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <ComboBox x:Name="CmbAuthor" Width="150" Margin="3"
                                  DisplayMemberPath="FullName"/>
                        <TextBlock Text="Статус:" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <ComboBox x:Name="CmbStatus" Width="110" Margin="3"/>
                        <Button Content="Найти" Width="70" Margin="3" Click="BtnSearch_Click"/>
                        <Button Content="Сброс" Width="70" Margin="3" Click="BtnReset_Click"/>
                    </WrapPanel>

                    <!-- Таблица -->
                    <DataGrid Grid.Row="1" x:Name="GridDocuments"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding DocumentID}" Width="50"/>
                            <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="250"/>
                            <DataGridTextColumn Header="Тип" Binding="{Binding DocType}" Width="120"/>
                            <DataGridTextColumn Header="Автор" Binding="{Binding AuthorName}" Width="150"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="110"/>
                            <DataGridTextColumn Header="Дата"
                                                Binding="{Binding CreatedDate, StringFormat=dd.MM.yyyy}"
                                                Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Кнопки -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="0,5,0,0">
                        <Button x:Name="BtnAdd" Content="Добавить" Width="100" Margin="3"
                                Click="BtnAdd_Click"/>
                        <Button x:Name="BtnEdit" Content="Редактировать" Width="110" Margin="3"
                                Click="BtnEdit_Click"/>
                        <Button x:Name="BtnDelete" Content="Удалить" Width="100" Margin="3"
                                Click="BtnDelete_Click"/>
                        <Button x:Name="BtnVersions" Content="Версии" Width="100" Margin="3"
                                Click="BtnVersions_Click"/>
                        <Button Content="Экспорт" Width="100" Margin="3"
                                Click="BtnExport_Click"/>
                        <Button Content="Обновить" Width="100" Margin="3"
                                Click="BtnSearch_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>