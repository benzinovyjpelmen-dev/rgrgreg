<Window x:Class="CultureDocs.Views.VersionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Версии документа" Height="500" Width="800"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TxtHeader"
                   FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

        <DataGrid Grid.Row="1" x:Name="GridVersions"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding VersionNumber}" Width="60"/>
                <DataGridTextColumn Header="Дата"
                                    Binding="{Binding CreatedDate, StringFormat=dd.MM.yyyy HH:mm}"
                                    Width="150"/>
                <DataGridTextColumn Header="Автор" Binding="{Binding AuthorName}" Width="150"/>
                <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Создать версию" Width="130" Height="30" Margin="3"
                    Click="BtnCreateVersion_Click"/>
            <Button Content="Восстановить" Width="120" Height="30" Margin="3"
                    Click="BtnRestore_Click"/>
            <Button Content="Закрыть" Width="100" Height="30" Margin="3"
                    Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>